Two Button Latch Example Program

This project will turn on "Output" when two buttons ("Button 1" and "Button 2") are pushed. The output will latch on after both buttons remain pushed for 3 seconds. If either button is released before 3 seconds has elapsed, "Output" will turn off. "Output" will also turn off if "Button 3" is pressed.</comment><disabled>false</disabled><elements xsi:type="adcXmlRllElement"><elementType>1</elementType><subType>7</subType><position>0</position><repeat>0</repeat></elements><elements xsi:type="adcXmlRllElement"><elementType>0</elementType><instruction xsi:type="adcInstNO"><comment></comment><inUse>true</inUse><indexTagNameMap xsi:type="map"><type>java.util.HashMap</type></indexTagNameMap><isEnabled>true</isEnabled><isValid>true</isValid><operand><data xsi:type="tagStub"><ID>C-000001</ID><name>Button 1</name><type>11</type></data><dataType>0</dataType><enabled>true</enabled></operand><rungPlacements>1</rungPlacements><usingStructure>false</usingStructure></instruction><subType>0</subType><position>1</position><repeat>0</repeat></elements><elements xsi:type="adcXmlRllElement"><elementType>1</elementType><subType>7</subType><position>2</position><repeat>0</repeat></elements><elements xsi:type="adcXmlRllElement"><elementType>0</elementType><instruction xsi:type="adcInstNO"><comment></comment><inUse>true</inUse><indexTagNameMap xsi:type="map"><type>java.util.HashMap</type></indexTagNameMap><isEnabled>true</isEnabled><isValid>true</isValid><operand><data xsi:type="tagStub"><ID>C-000002</ID><name>Button 2</name><type>11</type></data><dataType>0</dataType><enabled>true</enabled></operand><rungPlacements>1</rungPlacements><usingStructure>false</usingStructure></instruction><subType>0</subType><position>3</position><repeat>0</repeat></elements><elements xsi:type="adcXmlRllElement"><elementType>1</elementType><subType>1</subType><position>4</position><repeat>0</repeat></elements><elements xsi:type="adcXmlRllElement"><elementType>0</elementType><instruction xsi:type="adcInstNC"><com